# Dépendances
node_modules/

# Builds (l'installeur se télécharge dans les Releases GitHub)
dist/

# Caches et divers
*.log
.DS_Store
Thumbs.db

# Tailles intermediaires de l'icone (regenerees par : npm run icon)
build/icon-*.png
build/_*.html

# Produits de compilation Android (l'APK se telecharge dans les Releases)
android-app/build/
*.apk
*.idsig

# VST3 SDK (fetched by npm run build:vst) and native build output
native/vst3sdk/
native/vsthost/build/
native/tpb/
native/engine/build/
native/engine/build-tests/
native/engine/build-tests-*/
# per-engineer build folders of the native engine (build-<label>, build-verify-<key>, ...)
native/engine/build*/
# the integrator's private snapshot and builds (host module)
native/engine/build-host/
# Native engine: golden renders (tools/make-goldens.js), per-module patch snapshots, build lock
native/engine/goldens/
native/engine/patches/
native/engine/.build.lock
